# Copiază în .env.local și completează. Variabilele NEXT_PUBLIC_ ajung în browser; celelalte rămân pe server.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Doar pe server: scrie starea abonamentului din webhook-ul Stripe. Nu o pune niciodată într-o variabilă NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Adresa publică a site-ului, cu https:// și fără / la final (ex. https://domeniul-tau.ro). Din ea se fac linkurile
# canonice, sitemap-ul, robots.txt, imaginea de distribuire și redirecționările de la Stripe.
# Pune aici DOAR un domeniu pe care îl deții. Lăsată goală: pe Vercel se folosește domeniul de producție al
# proiectului (VERCEL_PROJECT_PRODUCTION_URL), iar local http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Stripe (Developers → API keys; folosește întâi cheile de test)
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → endpoint https://SITE/api/stripe/webhook, evenimentele:
# checkout.session.completed, customer.subscription.created/updated/deleted, invoice.paid, charge.refunded
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → prețurile recurente ale planului Complet
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Oblio (facturi fiscale + e-Factura). Setări → Date cont → API: emailul contului și secretul API.
# Fără ele plățile merg, dar facturile nu se emit automat.
OBLIO_EMAIL=
OBLIO_API_SECRET=
# CUI-ul firmei, fără RO (ex. 12345678) și seria de facturi definită în Oblio
OBLIO_CIF=
OBLIO_SERIES=
# Opțional: seria pentru storno (implicit aceeași), cota TVA (Normala / 21). Pentru firmă neplătitoare de TVA: OBLIO_VAT_NAME=SDD, OBLIO_VAT_PERCENT=0
OBLIO_STORNO_SERIES=
OBLIO_VAT_NAME=Normala
OBLIO_VAT_PERCENT=21
# 1 = trimite factura pe email clientului / trimite automat în SPV (e-Factura)
OBLIO_SEND_EMAIL=1
OBLIO_SPV=1

# PostHog (statistici de folosire, opțional): Project settings → Project API key. Server UE.
# Fără cookie-uri; câmpurile completate sunt ascunse în înregistrări.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Datele firmei (identificarea comerciantului, cerută de Legea 365/2002 și OUG 34/2014). Apar în subsolul fiecărei
# pagini și pe paginile Termeni și Confidențialitate. Un câmp gol pur și simplu nu se afișează.
# Denumirea completă, ex. Exemplu S.R.L.
NEXT_PUBLIC_OPERATOR_NAME=
# Codul fiscal (CUI), ex. RO12345678 sau 12345678
NEXT_PUBLIC_OPERATOR_CUI=
# Numărul de ordine din Registrul Comerțului, ex. J40/1234/2020
NEXT_PUBLIC_OPERATOR_REG_COM=
# Sediul social, ex. Str. Exemplu nr. 1, București
NEXT_PUBLIC_OPERATOR_ADDRESS=
# E-mailul de contact pentru clienți
NEXT_PUBLIC_OPERATOR_EMAIL=
# Telefonul de contact, ex. +40 721 000 000
NEXT_PUBLIC_OPERATOR_PHONE=
