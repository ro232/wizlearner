# Copiază în .env.local și completează. Variabilele NEXT_PUBLIC_ ajung în browser; celelalte rămân pe server.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Doar pe server: scrie starea abonamentului din webhook-ul Stripe. Nu o pune niciodată într-o variabilă NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Adresa publică a site-ului (pentru redirecționările de la Stripe)
NEXT_PUBLIC_SITE_URL=https://worksheetwiz.ro

# Stripe (Developers → API keys; folosește întâi cheile de test)
STRIPE_SECRET_KEY=sk_test_...
# Developers → Webhooks → endpoint https://SITE/api/stripe/webhook, evenimentele:
# checkout.session.completed, customer.subscription.created/updated/deleted
STRIPE_WEBHOOK_SECRET=whsec_...
# Products → prețurile recurente ale planului Complet
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_YEARLY=price_...

# Datele firmei, afișate pe paginile Confidențialitate și Termeni
NEXT_PUBLIC_OPERATOR_NAME=
NEXT_PUBLIC_OPERATOR_CUI=
NEXT_PUBLIC_OPERATOR_ADDRESS=
NEXT_PUBLIC_OPERATOR_EMAIL=
